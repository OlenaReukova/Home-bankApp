<configuration>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>%gray(%d{HH:mm:ss.SSS}) %highlight(%-5level) %cyan(%logger{36}) %yellow([%X{correlationId}]) - %msg%n</pattern>

        </encoder>

    </appender>


    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>